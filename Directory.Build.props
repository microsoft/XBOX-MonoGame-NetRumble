<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>NetRumble</Product>
    <Company>Microsoft ATG</Company>
    <Copyright>Copyright (c) Microsoft Corporation.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
  </PropertyGroup>

  <!--
    Which cloud save tier the GDK provider compiles against.

    The two tiers cannot coexist: both roam the same keys, so having both would mean two
    copies of a player's progress that silently disagree. XGameSave - the GDK's connected
    storage - is the default because it is the save system XBOX certification is written
    against and the only one the platform will sync between a player's devices. Build with
    /p:NetRumbleCloudSave=PlayFab to fall back to the PlayFab user-data tier, which needs
    no console and is what the desktop PlayFab-only provider uses regardless.
  -->
  <PropertyGroup>
    <NetRumbleCloudSave Condition="'$(NetRumbleCloudSave)' == ''">XGameSave</NetRumbleCloudSave>
    <DefineConstants Condition="'$(NetRumbleCloudSave)' == 'PlayFab'">$(DefineConstants);NETRUMBLE_PLAYFAB_GAMESAVE</DefineConstants>
  </PropertyGroup>

  <!--
    A misspelled value would otherwise pick the default silently, which is the one
    outcome a build switch must never do: the resulting package looks correct and stores
    a player's saves somewhere other than where the person building it intended.
  -->
  <Target Name="ValidateNetRumbleCloudSave" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NetRumbleCloudSave)' != 'XGameSave' AND '$(NetRumbleCloudSave)' != 'PlayFab'"
           Text="NetRumbleCloudSave must be 'XGameSave' or 'PlayFab'; got '$(NetRumbleCloudSave)'." />
  </Target>

</Project>
