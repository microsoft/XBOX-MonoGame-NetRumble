<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <!--
    The PC (Gaming.Desktop) package identity.

    Why this is a separate file from MicrosoftGame.config rather than the same one:
    MakePkg validates that every executable the config declares is actually present in
    the layout it is packing. MicrosoftGame.config declares both NetRumblePC.exe and
    NetRumbleConsole.exe, because it is also the file the unpackaged desktop build and
    the platform spike stage beside themselves for their title identity - a PC layout
    built from it is rejected for the missing console executable. The console halves
    already had this split (MicrosoftGame.GDKX.*.config); this is the PC one.

    Identity, StoreId, TitleId and MSAAppId are identical to the other configs on
    purpose - see the comment in MicrosoftGame.config for which identifiers come from
    the title, and why AdvancedUserModel must stay true.

    Executable Name must match what tools\Build-GdkPc.ps1 renames the published apphost
    to. The rename is safe: a .NET apphost locates its managed assembly through an
    embedded "NetRumble.Game.dll" path, not through its own file name.
  -->

  <Identity Name="41336MicrosoftATG.MonoGameRumble"
            Publisher="CN=A4954634-DF4B-47C7-AB70-D3215D246AF1"
            Version="1.0.3.0" />

  <ExecutableList>
    <Executable Name="NetRumblePC.exe"
                Id="Game"
                TargetDeviceFamily="PC" />
  </ExecutableList>
  <StoreId>9NN39VF9LFBQ</StoreId>

  <TitleId>7B3671B8</TitleId>
  <MSAAppId>0000000045A95A08</MSAAppId>

  <ShellVisuals
    DefaultDisplayName="MonoGameRumble"
    PublisherDisplayName="Xbox ATG"
    StoreLogo="storelogos\StoreLogo.png"
    Square150x150Logo="storelogos\Logo.png"
    Square44x44Logo="storelogos\SmallLogo.png"
    Square480x480Logo="storelogos\LargeLogo.png"
    Description="MonoGame port of the Microsoft ATG NetRumble sample."
    ForegroundText="light"
    BackgroundColor="#000000"
    SplashScreenImage="storelogos\SplashScreen.png" />

  <!-- Party uses protocol activation for multiplayer invites. DesktopRegistration is a
       PC-only element, which is the one part of this config that has no console
       counterpart rather than merely differing from it. -->
  <DesktopRegistration>
    <!-- libHttpClient, Party, PlayFabCore, PlayFabServices and the Xbox Services thunks
         all link against the VC++ runtime. The submission validator fails a package that
         ships them without declaring the framework dependency, because nothing would
         install the redistributable on the target machine. Console packages need no
         equivalent - the runtime is part of the console OS image. -->
    <DependencyList>
      <KnownDependency Name="VC14" />
    </DependencyList>
    <MultiplayerProtocol Executable="NetRumblePC.exe">true</MultiplayerProtocol>
  </DesktopRegistration>

  <AdvancedUserModel>true</AdvancedUserModel>

  <!--
    Settings, the local achievement tier and the match history live in persistent local
    storage. A packaged PC title runs out of a read-only install just as a console title
    does, so XPersistentLocalStorageGetPath needs this declaration here too - the folder
    beside the executable that works for an unpackaged build is not writable once the
    package is installed.
  -->
  <PersistentLocalStorage>
    <SizeMB>64</SizeMB>
  </PersistentLocalStorage>
</Game>
