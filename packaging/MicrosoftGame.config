<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <!--
    The MonoGame port's package identity.

    This is the Godot port's MicrosoftGame.config with the executable names and
    the title identity changed: Identity Name, StoreId, MSAAppId and TitleId are
    this port's own product in Partner Center, not the C++ and Godot builds'.
    Only the Publisher is shared, because the products live under the same
    publisher account. TitleId is 7B3671B8, and the SCID XSAPI initializes with
    must be the service configuration published for it - see
    packaging/xboxservices.config. Sign-in and achievements (ids 1-10) resolve
    against that service configuration, so it has to carry those definitions.

    AdvancedUserModel MUST stay true. The C++ sample sets it false because it
    drives the legacy single-user model, but this port signs in through
    XUserAddAsync, which is the advanced user model API. With
    AdvancedUserModel false the Game Core runtime terminates the process with
    0x89240102 during runtime initialisation, before any managed code runs, so
    the game appears to fail to launch with no error of its own.

    The PlayFab title id is a different identifier for a different service and
    is configured in NetRumble.Platform/PlayFabConfiguration.cs, not here.

    Unlike the Godot config, nothing here is parsed by a non-XML-aware exporter,
    so the ordering and comment-wording constraints documented in the Godot file
    do not apply. The PC entry is still listed first purely to keep the two
    files diffable.

    Executable Name must match the file names the packaging script stages -
    see packaging/Make-Package.ps1, which renames the published apphost. The
    rename is safe: a .NET apphost locates its managed assembly by the embedded
    "NetRumble.Game.dll" path, not by its own file name.
  -->

  <Identity Name="41336MicrosoftATG.MonoGameRumble"
            Publisher="CN=A4954634-DF4B-47C7-AB70-D3215D246AF1"
            Version="1.0.3.0" />

  <ExecutableList>
    <Executable Name="NetRumblePC.exe"
                Id="GamePC"
                TargetDeviceFamily="PC" />
    <Executable Name="NetRumbleConsole.exe"
                Id="GameConsole"
                TargetDeviceFamily="Scarlett" />
  </ExecutableList>
  <StoreId>9NN39VF9LFBQ</StoreId>

  <TitleId>7B3671B8</TitleId>
  <MSAAppId>0000000045A95A08</MSAAppId>

  <ShellVisuals
    DefaultDisplayName="MonoGameRumble"
    PublisherDisplayName="Xbox ATG"
    StoreLogo="storelogos\StoreLogo.png"
    Square150x150Logo="storelogos\Logo.png"
    Square44x44Logo="storelogos\SmallLogo.png"
    Square480x480Logo="storelogos\LargeLogo.png"
    Description="MonoGame port of the Microsoft ATG NetRumble sample."
    ForegroundText="light"
    BackgroundColor="#000000"
    SplashScreenImage="storelogos\SplashScreen.png" />

  <!-- Party uses protocol activation for multiplayer invites. DesktopRegistration
       is a PC-only element, so it names the PC executable. -->
  <DesktopRegistration>
    <MultiplayerProtocol Executable="NetRumblePC.exe">true</MultiplayerProtocol>
  </DesktopRegistration>

  <AdvancedUserModel>true</AdvancedUserModel>

</Game>
