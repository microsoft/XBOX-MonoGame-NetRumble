<?xml version="1.0" encoding="utf-8"?>
<Game configVersion="1">
  <Identity Name="41336MicrosoftATG.MonoGameRumble"
            Publisher="CN=A4954634-DF4B-47C7-AB70-D3215D246AF1"
            Version="1.0.3.0" />

  <ExecutableList>
    <Executable Name="NetRumbleConsole.exe"
                Id="Game"
                TargetDeviceFamily="XboxOne" />
  </ExecutableList>
  <StoreId>9NN39VF9LFBQ</StoreId>

  <TitleId>7B3671B8</TitleId>
  <MSAAppId>0000000045A95A08</MSAAppId>

  <ShellVisuals
    DefaultDisplayName="MonoGameRumble"
    PublisherDisplayName="Xbox ATG"
    StoreLogo="storelogos\StoreLogo.png"
    Square150x150Logo="storelogos\Logo.png"
    Square44x44Logo="storelogos\SmallLogo.png"
    Square480x480Logo="storelogos\LargeLogo.png"
    Description="MonoGame port of the Microsoft ATG NetRumble sample."
    ForegroundText="light"
    BackgroundColor="#000000"
    SplashScreenImage="storelogos\SplashScreen.png" />

  <AdvancedUserModel>true</AdvancedUserModel>

  <!--
    Persistent local storage is where settings, the local achievement tier and the match
    history live on console: the install is mapped read-only, so a LocalData folder beside
    the executable is silently unwritable. XPersistentLocalStorageGetPath cannot answer
    without this declaration, however correct the calling code is. 64 MB is far more than
    a few JSON files need; the guidance is to ask for as little as possible, because a
    large allocation slows Xbox Game Streaming launches.
  -->
  <PersistentLocalStorage>
    <SizeMB>64</SizeMB>
  </PersistentLocalStorage>
</Game>
